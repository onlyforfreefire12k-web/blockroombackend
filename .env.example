# Blockroom Telegram bot — copy to .env for local dev, or set in Render.
# NEVER commit real values. This file contains names only.

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_COLLECTION_PREFIX=
YOUTUBE_API_KEY=
MINI_APP_URL=https://t.me/YourBot/yourminiapp
RENDER_EXTERNAL_URL=https://your-service.onrender.com
AUTO_SET_WEBHOOK=true
# webhook | polling | off  (polling needs no public URL)
BOT_MODE=polling
MAX_INIT_DATA_AGE_SECONDS=86400
ROOM_CAPACITY=12
