# ============================================================================
# Blockroom Telegram bot - local development template
# Copy to `.env` and fill in real values.  NEVER commit the filled-in file.
# In production, set these in the Render dashboard instead (render.yaml).
# ============================================================================

# --- Telegram (required) ----------------------------------------------------
# From @BotFather: /newbot
TELEGRAM_BOT_TOKEN=123456789:REPLACE-WITH-YOUR-BOTFATHER-TOKEN
# Any long random string (32+ chars).  Telegram echoes it in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- Firebase (required) ----------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: paste the ENTIRE service-account JSON on ONE line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# Option B (easier locally): point at the downloaded file:
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Backend selection: "firestore" (default) or "rtdb" (Realtime Database).
FIREBASE_BACKEND=firestore
# Required only when FIREBASE_BACKEND=rtdb:
# FIREBASE_RTDB_URL=https://your-project-default-rtdb.firebaseio.com
# Optional prefix so the bot writes to e.g. blockroom_rooms/{roomId}:
# FIREBASE_COLLECTION_PREFIX=

# --- Mini App / game (required for the /start button and /room join links) --
# Format A (recommended): the t.me link BotFather gives you via /newapp:
MINI_APP_URL=https://t.me/YourBot/your_mini_app
# Format B: any https:// URL served as a Mini App is also supported.

# --- YouTube (required for /play and /vplay) --------------------------------
YOUTUBE_API_KEY=AIzaSyD41TMxyE88ivT-r_MGI6RSIM4QP-adZTg

# --- Deployment (Render injects RENDER_EXTERNAL_URL automatically) ----------
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
AUTO_SET_WEBHOOK=true

# --- Tuning (optional) -------------------------------------------------------
# MAX_INIT_DATA_AGE_SECONDS=86400
# RATE_LIMIT_ROOMS_PER_HOUR=5
# RATE_LIMIT_SEARCHES_PER_MINUTE=12
# RATE_LIMIT_CONTROLS_PER_MINUTE=20
# RATE_LIMIT_CALLBACKS_PER_MINUTE=60
# RATE_LIMIT_AUTH_PER_MINUTE=30
# LOG_LEVEL=INFO

# --- LOCAL DEVELOPMENT ONLY - never enable in production --------------------
# Lets the webhook accept requests without a configured secret (curl testing).
# ALLOW_INSECURE_WEBHOOK=false
